{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/main.iwsdk.scene.json",
  "assets": {
    "module": "./src/assets"
  },
  "components": {
    "module": "./src/components"
  },
  "world": {
    "xr": {
      "mode": "ar",
      "offer": "always",
      "features": {
        "handTracking": true,
        "depthSensing": { "required": false, "usage": "gpu-optimized", "format": "float32" },
        "planeDetection": true
      }
    },
    "input": {
      "canvasPointerEvents": true
    },
    "render": {
      "near": 0.01,
      "far": 100,
      "camera": {
        "position": [0, 1.5, 0.5]
      }
    },
    "features": {
      "locomotion": false,
      "grabbing": false,
      "physics": false,
      "sceneUnderstanding": true,
      "environmentRaycast": false,
      "spatialUI": false
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "environment": "living_room"
    }
  }
}

# LLM Configuration
# Set to "proxy" on Railway/production to route through server-side API
NEXT_PUBLIC_LLM_MODE=direct

# Ollama endpoint (Cloudflare tunnel URL for production)
# Only used server-side when LLM_MODE=proxy
LLM_OLLAMA_URL=http://localhost:11434

# OpenRouter fallback (used when Ollama is unreachable)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Ollama connection timeout in ms (default: 5000)
LLM_OLLAMA_TIMEOUT=5000

# Notion Leaderboard (Hall of Fame)
# Create integration at https://www.notion.so/my-integrations
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ─── REQUIRED FOR PRODUCTION (Grok pre-publish blockers) ───────────────────
# HMAC secret for marker-session early-bird discount guard.
# Without this in production, a random ephemeral secret is used (sessions die on redeploy).
# Generate: openssl rand -hex 32
MARKER_SESSION_SECRET=

# Optional alias accepted by markerSession.ts
# BOBR_SERVER_SECRET=

# DM Table queue signing + admin mint (server-only)
# DM_QUEUE_SIGNING_SECRET=
# DM_QUEUE_ADMIN_TOKEN=

# Sqlite persistence: mount a Railway volume at /data (discount_codes.db, worker.db).
# Without /data, DBs fall back to /tmp and vanish on every redeploy.
# (No env var — path is hardcoded to /data when the directory exists.)

# Sacred / burial-site GAMEPLAY (karma/XP on visitSpiritualSite). Default OFF.
# Educational copy may still exist in data files; gamification stays gated.
# Opt-in only after Leif + tribal review: set to 1
# NEXT_PUBLIC_SACRED_SITE_GAMEPLAY=0
